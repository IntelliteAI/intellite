{
  "description": "Intellite Stack sync and instructions (SessionStart).",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"${CLAUDE_PLUGIN_ROOT}/sync\"; ./intellite-sync hook claude",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
